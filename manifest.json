{
  "id": "Steam",
  "name": "Steam Metadata",
  "version": "1.0.2",
  "api_version": 1,
  "fields": [
    "Name",
    "SortingName",
    "ReleaseDate",
    "Genres",
    "Developers",
    "Publishers",
    "Platforms",
    "Features",
    "Description",
    "FullDescription",
    "Links",
    "CriticScore",
    "Icon",
    "CoverImage",
    "HeaderImage",
    "BackgroundImage"
